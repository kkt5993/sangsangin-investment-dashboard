빈티지는 별도 과제입니다.","달력은 계획이며 변경될 수 있습니다. 원문 미표기 발표시각·국가데이터처 미공개 다음 연도·계획에 없는 긴급회의와 과거 발표 당시 PIT 국면은 별도 대상입니다."],"subviews":[{"name":"월별 국면","status":"connected","sections":4,"reason":""},{"name":"미국 경제국면","status":"connected","sections":2,"reason":""},{"name":"한국 시장국면","status":"connected","sections":2,"reason":""},{"name":"시장국면","status":"connected","sections":6,"reason":""},{"name":"국면별 성과","status":"connected","sections":2,"reason":""},{"name":"국면 전이","status":"connected","sections":2,"reason":""},{"name":"밸류에이션","status":"connected","sections":3,"reason":""},{"name":"실적 이벤트","status":"connected","sections":1,"reason":""},{"name":"거시 발표 달력","status":"connected","sections":1,"reason":""},{"name":"산업별 핵심지표","status":"connected","sections":1,"reason":""},{"name":"Soros 재귀성","status":"connected","sections":12,"reason":"원본 복합 산식과 지수 이익 역사 필요"}]},"risk":{"status":"partial","as_of":"2026-09-08","bytes":447691,"sections":81,"missing":["전체 만기 딜러 포지션 및 레버리지 ETF 실제 순유입 원장은 연결되지 않았습니다. 옵션 IV를 고정한 가격 시나리오는 변동성 곡면 변화를 반영하지 않습니다.","레버리지 ETF는 수집 원장의 명시적 표본으로 전 세계 모든 상품이 아닙니다. 국내 단일주식/해외 한국주식 LETF, 전 만기 옵션·실제 딜러 inventory는 미포함입니다. 공매도·AUM 제공처 지연을 확인해야 합니다.","국내 취약성의 원본 비공개 가중치·예측력과 실제 딜러 포지션은 미확인입니다. 공식 ETF 현재 정의는 역사 PIT 구성 이력이 아니며 실제 설정/환매·헤지는 리밸런싱 시나리오에 미포함입니다.","신호등의 원본 다단계 점수·상대강도 기간·뉴스감성 분모와 CSD/군집의 세부 산식은 미공개입니다. 팀 설정과 SF Fed 백분위 대용을 명시했으며, 당시 관측 빈티지나 급락 예측력의 동등성은 미검증입니다."],"subviews":[{"name":"리스크 콕핏","status":"connected","sections":13,"reason":""},{"name":"신호등 US·KR","status":"connected","sections":12,"reason":""},{"name":"선제위험·감마","status":"connected","sections":5,"reason":""},{"name":"파생·옵션","status":"connected","sections":11,"reason":""},{"name":"KOSPI 숏감마","status":"connected","sections":9,"reason":""},{"name":"쏠림·신용","status":"connected","sections":2,"reason":""},{"name":"CFTC 포지션","status":"connected","sections":5,"reason":""},{"name":"파생 Wag-the-Dog","status":"connected","sections":11,"reason":""},{"name":"비펀더멘탈 수급","status":"connected","sections":13,"reason":"종목·레버리지